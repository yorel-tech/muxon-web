# OIDC (browser) — must match Keycloak realm + public client (see muxon-core/compose/keycloak/realm-muxon-dev.json).
# Copy to .env.local and restart `npm run dev` after changes (NEXT_PUBLIC_* are inlined at dev server start).
# Keycloak client must list Web origins: http://localhost:4000 (browser calls 8085 for discovery + token).
NEXT_PUBLIC_OIDC_AUTHORITY=http://localhost:8085/realms/muxon-dev
NEXT_PUBLIC_OIDC_CLIENT_ID=muxon-web
NEXT_PUBLIC_OIDC_REDIRECT_URI=http://localhost:4000/auth/callback
NEXT_PUBLIC_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:4000/
NEXT_PUBLIC_OIDC_SCOPE=openid profile email

# API (used by Next rewrites and client)
NEXT_PUBLIC_API_BASE=http://localhost:8080
